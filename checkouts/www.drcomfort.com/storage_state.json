          "name": "tm_cart",
          "value": "[{\"id\":48941102563511,\"properties\":{\"_insert_group\":\"51945-M-09.0-1\",\"_has_auto_insert\":\"true\"},\"quantity\":1,\"variant_id\":48941102563511,\"key\":\"48941102563511:fab0c80f097a442e0aa2e43348cb5b1f\",\"title\":\"Don - White / 9 / Medium (B/C/D)\",\"price\":12999,\"original_price\":12999,\"presentment_price\":129.99,\"discounted_price\":12999,\"line_price\":12999,\"original_line_price\":12999,\"total_discount\":0,\"discounts\":[],\"sku\":\"51945-M-09.0\",\"grams\":0,\"vendor\":\"Dr. Comfort\",\"taxable\":true,\"product_id\":8665599246519,\"product_has_only_default_variant\":false,\"gift_card\":false,\"final_price\":12999,\"final_line_price\":12999,\"url\":\"/products/don-mens-orthopedic-slip-ons?variant=48941102563511\",\"featured_image\":{\"aspect_ratio\":1,\"alt\":\"Don Men\u2019s Hands-Free Shoe White #White\",\"height\":2048,\"url\":\"https://cdn.shopify.com/s/files/1/0742/1172/1399/files/2606-DON-WHITENAVY-34-1.jpg?v=1787930285\",\"width\":2048},\"image\":\"https://cdn.shopify.com/s/files/1/0742/1172/1399/files/2606-DON-WHITENAVY-34-1.jpg?v=1787930285\",\"handle\":\"don-mens-orthopedic-slip-ons\",\"requires_shipping\":true,\"product_type\":\"Best Sellers\",\"product_title\":\"Don\",\"product_description\":\"\\n\\n\\n\\n\\n\\n\\nAbout Don\\nIntroducing Don \u2013 a high-quality, hands-free orthopedic shoe from Dr. Comfort\u2019s Quick-Fit line, designed for both ease and comfort. With its effortless slip-on design, Don allows you to step into the shoes without bending over or using your hands, making it perfect for those with limited mobility.Crafted for all-day wear, this orthopedic shoe offers superior comfort with its lightweight construction, cushioned insole, and breathable materials. Whether you're at home or on the go, Don provides gentle support and a secure fit, ensuring you experience both style and functionality throughout your day. Perfect for anyone seeking high-quality footwear with added convenience.\\nAdditional Details\\nWidths:\u00a0Medium (B/C/D), Wide (E/EE), Extra Wide (EEE/EEEE)Sizes:\u00a0White/Navy, Black (7 - 12, 13, 14) Light Blue, Green, Brown (9 - 12,13,14)Colors:\u00a0White/Navy, Black, Light Blue, Green, BrownMaterial:\u00a0Mesh/Synthetic PU Upper with Synthetic Lining, EVA/Rubber-Latex OutsoleCollection:\u00a0Dr Comfort\u00ae Quick-FitHCPCS / NDC:\u00a0A5500 Shoes / 000005500\\nInstruction: If you experience any pain, swelling, sensation changes, or any unusual reactions while using this product, consult your medical professional immediately. Check your feet each day for redness.\\nProduct Care:\u00a0\\n\\nClean your shoes regularly\\nIf your shoes are dirty, we suggest that you first clean them with a damp cloth. If needed, try a gentle detergent and spot treat. Do not bleach.\\nNever place shoes in the dryer, let them air dry. If you are cleaning white shoes, try putting them in the sun to dry.\\n\\n\\n\\n\\n\\n\\n\\n\",\"variant_title\":\"White / 9 / Medium (B/C/D)\",\"variant_options\":[\"White\",\"9\",\"Medium (B/C/D)\"],\"options_with_values\":[{\"name\":\"Color\",\"value\":\"White\"},{\"name\":\"Size\",\"value\":\"9\"},{\"name\":\"Width\",\"value\":\"Medium (B/C/D)\"}],\"line_level_discount_allocations\":[],\"line_level_total_discount\":0,\"quantity_rule\":{\"min\":1,\"max\":null,\"increment\":1},\"has_components\":false},{\"id\":49096359280823,\"properties\":{\"_insert_group\":\"51945-M-09.0-1\",\"_auto_insert\":\"true\"},\"quantity\":1,\"variant_id\":49096359280823,\"key\":\"49096359280823:c6127fdb55a58e083a498d833157f51c\",\"title\":\"ArchPro Insert (Pair) Round - U 9/10.5\",\"price\":0,\"original_price\":0,\"presentment_price\":0,\"discounted_price\":0,\"line_price\":0,\"original_line_price\":0,\"total_discount\":0,\"discounts\":[],\"sku\":\"AP Round U 9/10.5\",\"grams\":0,\"vendor\":\"Dr. Comfort\",\"taxable\":true,\"product_id\":8741773148343,\"product_has_only_default_variant\":false,\"gift_card\":false,\"final_price\":0,\"final_line_price\":0,\"u